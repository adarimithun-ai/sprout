{
  "version": 2,
  "builds": [
    { "src": "index.html",                    "use": "@vercel/static" },
    { "src": "style.css",                     "use": "@vercel/static" },
    { "src": "script.js",                     "use": "@vercel/static" },
    { "src": "config.js",                     "use": "@vercel/static" },
    { "src": "manifest.json",                 "use": "@vercel/static" },
    { "src": "sw.js",                         "use": "@vercel/static" },
    { "src": "logo.png",                      "use": "@vercel/static" },
    { "src": "icons/**",                      "use": "@vercel/static" },
    { "src": ".well-known/assetlinks.json",   "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/.well-known/assetlinks.json",
      "headers": { "Content-Type": "application/json" },
      "dest": "/.well-known/assetlinks.json"
    },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
